---
import Button from './Button.astro';
---

<section class="bg-gold py-16 md:py-20">
  <div class="container text-center">
    <h2 class="text-ink mb-4">Ready to Start Your Project?</h2>
    <p class="text-ink/70 text-lg mb-8 max-w-2xl mx-auto">Get a free, no-obligation site visit and a transparent fixed quotation. Our multi-trade team handles the complete job.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/contact" variant="secondary">
        <span class="text-ink border-ink hover:bg-ink hover:text-gold">Request a Free Site Visit</span>
      </Button>
      <Button href="https://wa.me/971557782644?text=Hi%2C%20I%27d%20like%20a%20quote%20for%20" variant="whatsapp">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        WhatsApp Us
      </Button>
    </div>
  </div>
</section>
