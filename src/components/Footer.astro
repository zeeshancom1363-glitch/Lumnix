---
import { services } from '../data/services.js';
---

<footer class="bg-charcoal text-white/80">
  <div class="container py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div>
        <!-- LOGO: replace with SVG -->
        <div class="mb-4">
          <span class="text-white font-display font-bold text-xl tracking-wide">LUMINEX STAR</span>
          <span class="block text-slate text-[0.6rem] font-body font-medium tracking-[0.18em] mt-0.5">TECHNICAL SERVICES L.L.C</span>
        </div>
        <p class="text-sm leading-relaxed text-white/60 mb-4">Licensed by the Dubai Department of Economy and Tourism · Fully insured</p>
        <p class="text-sm text-white/50">Dubai, United Arab Emirates</p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-display font-semibold text-sm uppercase tracking-wider mb-4">Services</h3>
        <ul class="flex flex-col gap-2">
          {services.slice(0, 5).map(s => (
            <li>
              <a href={`/services/${s.slug}`} class="text-sm text-white/60 hover:text-gold-soft transition-colors">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-display font-semibold text-sm uppercase tracking-wider mb-4">More Services</h3>
        <ul class="flex flex-col gap-2">
          {services.slice(5).map(s => (
            <li>
              <a href={`/services/${s.slug}`} class="text-sm text-white/60 hover:text-gold-soft transition-colors">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-display font-semibold text-sm uppercase tracking-wider mb-4">Contact Us</h3>
        <ul class="flex flex-col gap-3">
          <li>
            <a href="tel:+971555855033" class="text-sm text-white/60 hover:text-gold-soft transition-colors flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +971 55 585 5033
            </a>
          </li>
          <li>
            <a href="https://wa.me/971557782644?text=Hi%2C%20I%27d%20like%20a%20quote%20for%20" class="text-sm text-white/60 hover:text-gold-soft transition-colors flex items-center gap-2" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              WhatsApp Us
            </a>
          </li>
          <li>
            <a href="mailto:info@luminexstar.ae" class="text-sm text-white/60 hover:text-gold-soft transition-colors flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              info@luminexstar.ae
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="container py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white/40">
      <p>&copy; {new Date().getFullYear()} Luminex Star Technical Services L.L.C. All rights reserved.</p>
      <a href="/privacy" class="hover:text-gold-soft transition-colors">Privacy Policy</a>
    </div>
  </div>
</footer>
