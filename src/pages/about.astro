---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { images } from '../data/images.js';
---

<Layout title="About Luminex Star | Licensed Technical Services in Dubai" description="Learn about Luminex Star Technical Services — a Dubai DET-licensed, fully insured multi-trade contractor delivering carpentry, plumbing, HVAC, tiling, and more.">
  <section class="bg-charcoal py-20 md:py-28">
    <div class="container text-center">
      <h1 class="text-white mb-4">About Luminex Star</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">A multi-trade technical services contractor, licensed and based in Dubai.</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container fade-rise">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="gold-rule"></span>
          <h2 class="mt-4 mb-6">Who We Are</h2>
          <div class="space-y-4 text-slate">
            <p>Luminex Star Technical Services L.L.C is a Dubai-based contractor providing building maintenance, fit-out, and technical services across the emirate. We hold a valid licence issued by the Dubai Department of Economy and Tourism and carry full liability insurance on every project.</p>
            <p>Our team operates across ten licensed trades — from plumbing and HVAC to carpentry and false ceilings — so you deal with one contractor instead of coordinating several. That means fewer delays, clearer accountability, and a single point of contact from enquiry to handover.</p>
            <p>We work with facilities managers, building owners, villa owners, fit-out project managers, and property management companies. Whether it is a minor repair or a complete floor-by-floor refurbishment, we deliver fixed-price quotations and stick to them.</p>
          </div>
        </div>
        <div class="aspect-[3/2] rounded-lg overflow-hidden">
          <img src={images.aboutTeam.src} alt={images.aboutTeam.alt} width={images.aboutTeam.w} height={images.aboutTeam.h} loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bg-alt py-16 md:py-24">
    <div class="container fade-rise">
      <SectionHeading title="Our Approach" centered />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center p-6">
          <div class="w-12 h-12 mx-auto mb-4 rounded-lg bg-gold/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
          </div>
          <h3 class="font-display font-semibold mb-2">Licensed and Insured</h3>
          <p class="text-slate text-sm">Every project carries full liability insurance. Our licence covers all ten trades we advertise — nothing more, nothing less.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 mx-auto mb-4 rounded-lg bg-gold/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="font-display font-semibold mb-2">One Team, All Trades</h3>
          <p class="text-slate text-sm">Plumbers, electricians, carpenters, and tiling specialists — all employed in-house. No subcontractor coordination needed.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 mx-auto mb-4 rounded-lg bg-gold/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>
          </div>
          <h3 class="font-display font-semibold mb-2">Transparent Pricing</h3>
          <p class="text-slate text-sm">You approve a fixed quotation before any work starts. No surprise charges, no hidden line items.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
