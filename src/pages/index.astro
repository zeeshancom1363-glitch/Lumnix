---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services.js';
import { images } from '../data/images.js';

const steps = [
  { num: '01', title: 'Enquiry', desc: 'Call, WhatsApp, or fill in the form. Tell us what you need.' },
  { num: '02', title: 'Site Visit', desc: 'A technician visits your property at no cost to assess the scope.' },
  { num: '03', title: 'Quotation', desc: 'You receive a transparent, fixed-price quotation — no hidden charges.' },
  { num: '04', title: 'Execution', desc: 'Our in-house team completes the work on schedule and to specification.' },
  { num: '05', title: 'Handover', desc: 'Final walkthrough, clean-up, and a maintenance support plan.' },
];

const whyUs = [
  { title: 'Licensed and Insured', desc: 'Licensed by the Dubai Department of Economy and Tourism with full liability coverage for every project.' },
  { title: 'In-House Multi-Trade Team', desc: 'Plumbers, electricians, carpenters, and tiling specialists — all under one roof. No subcontractor delays.' },
  { title: 'Transparent Fixed Quotations', desc: 'You approve the price before work begins. No surprise charges, ever.' },
  { title: 'Post-Handover Maintenance', desc: 'We stay available after the job is done. Warranty-backed maintenance for every project we deliver.' },
];
---

<Layout title="Luminex Star Technical Services — Licensed Contractor in Dubai" description="Licensed technical services contractor in Dubai — carpentry, plumbing, HVAC, tiling, electrical, glass & aluminium, and more. Get a free site visit and quote.">

  <!-- ═══ HERO ═══ -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <img
      src={images.hero.src}
      alt={images.hero.alt}
      width={images.hero.w}
      height={images.hero.h}
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-charcoal/55"></div>
    <div class="container relative z-10 py-20">
      <div class="max-w-2xl">
        <h1 class="text-white mb-6">Professional Technical Services in Dubai</h1>
        <p class="text-white/80 text-lg md:text-xl mb-8 max-w-xl">
          From plumbing and electrical to carpentry and false ceilings — one licensed contractor for every trade your property needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href="/contact">Get a Free Quote</Button>
          <Button href="https://wa.me/971557782644?text=Hi%2C%20I%27d%20like%20a%20quote%20for%20" variant="whatsapp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            WhatsApp Us
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST BAR ═══ -->
  <section class="bg-charcoal py-5">
    <div class="container">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/80 text-sm font-display font-semibold tracking-wide">
        <span>Dubai DET Licensed</span>
        <span class="text-gold hidden sm:inline">·</span>
        <span>Fully Insured</span>
        <span class="text-gold hidden sm:inline">·</span>
        <span>Multi-Trade In-House Team</span>
        <span class="text-gold hidden sm:inline">·</span>
        <span>24/7 Emergency Response</span>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES GRID ═══ -->
  <section class="bg-bg-alt py-16 md:py-24">
    <div class="container fade-rise">
      <SectionHeading title="Our Services" subtitle="Ten licensed trades — one reliable contractor" centered />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map(s => (
          <ServiceCard title={s.title} slug={s.slug} description={s.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHY LUMINEX STAR ═══ -->
  <section class="bg-bg py-16 md:py-24">
    <div class="container fade-rise">
      <SectionHeading title="Why Luminex Star" subtitle="What sets us apart from every other contractor in Dubai" centered />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {whyUs.map(item => (
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-gold/10 flex items-center justify-center mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <div>
              <h3 class="text-lg font-display font-semibold mb-1">{item.title}</h3>
              <p class="text-slate text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PROCESS ═══ -->
  <section class="bg-bg-alt py-16 md:py-24">
    <div class="container fade-rise">
      <SectionHeading title="How It Works" subtitle="From first call to final handover, in five clear steps" centered />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
        {steps.map((step, i) => (
          <div class="text-center">
            <div class="w-14 h-14 mx-auto rounded-full bg-gold text-ink font-display font-bold text-xl flex items-center justify-center mb-4">{step.num}</div>
            <h3 class="font-display font-semibold mb-2">{step.title}</h3>
            <p class="text-slate text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PROJECTS STRIP ═══ -->
  <section class="bg-bg py-16 md:py-24">
    <div class="container fade-rise">
      <SectionHeading title="Recent Projects" subtitle="A sample of our completed work across Dubai" centered />
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {images.projects.slice(0, 6).map(img => (
          <div class="aspect-[9/7] rounded-lg overflow-hidden">
            <img src={img.src} alt={img.alt} width={img.w} height={img.h} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <Button href="/projects" variant="secondary">View All Projects</Button>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS PLACEHOLDER ═══ -->
  <section class="bg-bg-alt py-16 md:py-24">
    <div class="container fade-rise text-center">
      <SectionHeading title="What Our Clients Say" centered />
      <!-- TestimonialPlaceholder: replace with real testimonials when available -->
      <div class="max-w-2xl mx-auto bg-bg rounded-lg border border-line p-8">
        <p class="text-slate italic">Client testimonials will appear here once collected. We are committed to transparency — only genuine reviews from verified clients.</p>
      </div>
    </div>
  </section>

  <!-- ═══ CTA BAND ═══ -->
  <CtaBand />
</Layout>
