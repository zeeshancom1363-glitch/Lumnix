---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Thank You | Luminex Star Technical Services" noindex={true} description="Thank you for contacting Luminex Star Technical Services. We will be in touch shortly.">
  <section class="py-24 md:py-32">
    <div class="container text-center max-w-xl mx-auto">
      <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-gold/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h1 class="mb-4">Thank You</h1>
      <p class="text-slate text-lg mb-8">Your message has been received. A member of our team will contact you within two business hours to discuss your requirements and arrange a free site visit if needed.</p>
      <Button href="/">Return to Home</Button>
    </div>
  </section>
</Layout>
